# The reference checkout, reachable for reading and lifting only.
# Never a build input: see CLAUDE.md and docs/README.md.
/reference

# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/

# Tooling
.pytest_cache/
.ruff_cache/
.pyright/
uv.lock

# Secrets. `.env` holds live provider keys; only the documented, valueless
# example is tracked. Listed before any tooling rule so a stray `git add -A`
# cannot reach it.
.env
.env.*
!.env.example

# Claude Code local state
.claude/settings.local.json

.DS_Store
