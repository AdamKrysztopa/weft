# Weft — the environment a developer needs, with no values.
#
# Copy to `.env` and fill in. `.env` is refused by `.gitignore`; this file is the
# only tracked one, which is why it must never carry a value.
#
# Weft does not read this file implicitly. Configuration precedence is owned by
# `docs/03-cli.md`, and `${env:VAR}` interpolation in the settings loader arrives
# at Phase 0 step 5 — see `docs/06-phase-0-build.md`. Until then, export these or
# use `docker compose`, which reads `.env` itself.

# --- LLM providers -----------------------------------------------------------
# Not needed before Phase 2. Phase 0 and Phase 1 run entirely offline: the
# walking skeleton ships a deterministic hashing embedder precisely so that
# nothing in the skeleton depends on a model download or an API key, and that
# embedder stays the default afterwards — `poe ci-checks` needs none of these.
#
# `OPENAI_API_KEY` is the first one anything reads, from Phase 2 task 2.29, and it
# is still not read implicitly: `[packs.weft-openai] api_key = "${env:OPENAI_API_KEY}"`
# in `weft.toml` is what interpolates it. The vendor SDK would happily pick this
# variable up on its own; `weft-openai` passes its key explicitly so that it cannot,
# for the same reason `WEFT_DATABASE_URL` is namespaced below.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# --- Store -------------------------------------------------------------------
# pgvector is the floor (G4 retired the zero-container target), and it arrives
# with `compose.yaml` at Phase 0 step 8.
#
# `weft-store` requires a `dsn` in its pack settings. The CLI offers this variable as
# `dsn` whenever it is set and a project's `weft.toml` does not say otherwise — the
# no-file convenience path `manual/quickstart.md` walks. A `weft.toml` naming
# `[packs.weft-store] dsn` explicitly — see `weft.toml.example` — wins over this
# variable, key by key, so a project can always commit an explicit connection string
# that a stray shell export cannot override.
#
# Namespaced on purpose. A bare `DATABASE_URL` in a developer's shell belongs to
# whichever project exported it last, and a store that silently connects to the
# wrong database is exactly the class of failure this project refuses: it does
# not crash, it produces a plausible answer against the wrong data.
WEFT_DATABASE_URL=postgresql://weft:weft@localhost:5433/weft

# --- Store, with real BM25 ---------------------------------------------------
# Only for `docker compose --profile bm25 up -d`, which starts a second Postgres
# on 5434 carrying `timescale/pg_textsearch` beside pgvector. It is a separate
# service rather than a floor upgrade because the image is 3.86 GB against the
# floor's 640 MB, and `01` → *Runtime shape* says the one container is the
# database — see `compose.yaml`, which carries the whole argument.
#
# Nothing reads this variable implicitly: point `WEFT_DATABASE_URL` at it, or set
# `[packs.store] dsn` in `weft.toml`, and set `text_mode = "bm25"` alongside. A
# store asking for BM25 against a database without the extension is refused by
# name — the floor container is exactly that case, deliberately.
WEFT_BM25_DATABASE_URL=postgresql://weft:weft@localhost:5434/weft
