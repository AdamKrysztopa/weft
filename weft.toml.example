# Weft — project configuration. Copy to `weft.toml` in the directory you run
# `weft` from; it is read relative to the working directory, not to the package.
#
# Optional as a file, but not optional in practice once a pack needs settings:
# `weft plugins doctor` will tell you which pack is `failed` and name the field
# it is missing.

# --- Pack settings -----------------------------------------------------------
# One block per pack, under its **pack name** — the `weft.packs` entry-point name
# `weft plugins list` prints in the first column, so `[packs.store]`, not
# `[packs.weft-store]`. That is not the same thing as the distribution name: one
# distribution can ship several packs (`weft-rag` ships twelve), and each of them
# configures itself. The `[packs] allow` list at the foot of this file is the one
# place distribution names are still what you write, because it is a trust decision
# about what you installed.
#
# Each block is validated against that pack's own Pydantic model *before* the pack's
# `register()` is called, so a settings mistake is a refusal at start-up rather
# than a stack trace somewhere inside a pipeline.

[packs.store]
# Required — the pack itself has no default, so a store never guesses at a
# database. `${env:...}` is interpolated by the settings loader, which keeps the
# secret in the environment and out of this file.
#
# **What is set here wins over the environment**, key by key. The CLI offers
# `${env:WEFT_DATABASE_URL}` as `dsn` only when this file does not say — a
# convenience for the no-file case the quickstart walks, not a second
# configuration system. An ambient value that overrode an explicit one would let
# a stale shell export send a project at the wrong database, and a store pointed
# at the wrong database does not crash: it answers plausibly.
dsn = "${env:WEFT_DATABASE_URL}"

# The text arm — what `search_text` means for this corpus. All three have
# defaults, so this whole group can be absent.
#
# `text_search_config` is the Postgres text search configuration, used for BOTH
# the stored index and the query, so they cannot disagree. `simple` folds case
# and splits on word boundaries and stems nothing — the honest choice for a
# mixed-language corpus, and the wrong one for an English-only corpus, where a
# question about "retrieval" never reaches a passage saying "retrieved". It is
# part of the schema: the index is a generated column, so changing this against
# a database that already has one is refused rather than silently ignored (see
# `manual/troubleshooting.md` → `TextSearchConfigMismatchError` for the two ways
# out). Measured on 1,548 English questions over 1,000 arXiv papers: lexical
# search alone put the right paper in its top five 24.4% of the time under
# `simple` and 68.1% under `english` (`manual/operations-guide.md` → *Tuning the
# text arm*).
#
# `text_query_mode` is `any` (a question matches on any of its words — the right
# default for natural language, since ANDing every word of a real question
# matches nothing) or `all` (every word must appear — what a keyword-style ask
# wants).
#
# `text_rank` is `cover-density` (how close the matched words fall to each
# other) or `frequency` (how often they occur, weighted).
#
# `text_rank_normalization` is Postgres's own ranking `normalization` bitmask —
# what the ranking does about passage length. `0`, the default, is no length
# normalisation at all: a thousand-word passage matching the same terms as a
# fifty-word one ranks identically. Weft measured its own corpus at task `21.2`
# and every arm tied, so the default did not move; `manual/operations-guide.md`
# carries the bit meanings.
#
# `text_mode` chooses what the text arm *is*. `fts` (the default) is everything
# above: a generated `tsvector` ranked by Postgres. `bm25` is real BM25 — IDF
# over the collection, term saturation, length normalisation — and needs the
# `timescale/pg_textsearch` extension, which needs PostgreSQL 17 or 18. The
# floor container is `pg16` and has neither, so asking for `bm25` there is
# refused by name rather than quietly served as `fts`. `docker compose
# --profile bm25 up -d` starts a database that can, on port 5434.
# text_search_config = "simple"
# text_query_mode = "any"
# text_rank = "cover-density"
# text_rank_normalization = 0
# text_mode = "fts"

# The vector arm — which index this store builds, and how a filtered search over
# it behaves. Both have defaults, so this group can be absent too.
#
# `index` is `exact` (the default) or `hnsw`. `exact` builds no index at all and
# every search is a sequential scan: correct always, and fine until the corpus
# grows — Weft measured its own p95 crossing 100 ms somewhere between 50,000 and
# 60,000 chunks at width 1536, roughly 300 papers (`manual/operations-guide.md`).
# `hnsw` builds an approximate index and is about a hundred times faster at that
# size. It is opt-in because turning it on rewrites nothing you already have, and
# leaving it off costs a deployment that never outgrows the scan nothing at all.
# `diskann` is a real member of the shared vocabulary and this backend does not
# serve it yet; asking for it is refused by name rather than quietly scanned.
#
# The index is built when the column's width is first committed — a pgvector HNSW
# index needs a dimensioned column, and Weft learns the dimension from the first
# embedded node it is ever given, so there is nothing to build before then.
#
# `iterative_scan` is the setting that decides whether a *filtered* search under
# `hnsw` tells you the truth, and **Weft does not inherit pgvector's own default
# here.** With `off` — pgvector's default — the index picks a fixed candidate set
# *before* your filter is applied, so a selective filter can leave almost nothing
# behind and the search returns a short list with no error at all. Measured on
# 100,142 real chunks: recall@10 of 0.003 at 0.1% selectivity, a mean of 0.03 rows
# out of the 10 asked for. `relaxed_order`, the default here, keeps scanning until
# it has enough post-filter candidates; it may return rows slightly out of order,
# which is why the store re-sorts by score before handing them back. `strict_order`
# preserves distance order at a little more cost. Set `off` only deliberately, and
# only if you never filter. Needs pgvector 0.8.0 or newer; an older server is
# refused by name (`manual/troubleshooting.md` → `IterativeScanUnsupportedError`).
#
# `hnsw_m` and `hnsw_ef_construction` are pgvector's own documented build
# defaults, exposed rather than moved: raising them builds a better graph more
# slowly, and nothing in Weft's own measurements asked for a different number.
# `precision` is `float32` (the default), `float16` or `binary` — what the *index* holds, never
# what the column holds. The column stays full-precision `vector(n)` and a compressed index is
# built over a cast of it, which is what lets a search rank by the original vectors even though
# it found its candidates through a lossy one. `int8` is a member of the shared vocabulary this
# backend has no form for — pgvector's HNSW indexes `vector`, `halfvec` and `bit` — so asking for
# it is refused by name. Qdrant serves it; the vocabulary is shared and the subsets are not.
#
# **Compression is a real trade and Weft measured it** on 100,142 chunks at width 1536, against
# the exact scan: `binary` reaches recall@10 of 0.989 at 0.94 ms p95 in a **50 MB** index built in
# 9.1 s, while `float16` (halfvec) reaches 0.9985 at 1.96 ms in **409 MB** built in 64.9 s. Binary
# is eight times smaller and seven times faster to build, for about one part in a hundred of
# recall. float32 stays the default regardless, until a persisted `weft eval` run puts a
# compressed arm inside the float32 baseline's own interval — a store benchmark is not that run.
#
# `rescore_oversampling` is how many candidates the compressed index fetches per result before
# they are re-ranked against the full-precision column: `oversampling × top_k`. **4 is measured,
# not conventional.** Binary recall@10 by oversampling: 1 → 0.8075, 2 → 0.9565, 4 → 0.989,
# 10 → 0.989. Four is where the curve flattens and ten is identical, so every candidate past four
# is paid for and buys nothing. Rescoring is also why the score you get back is a cosine
# similarity and not a bit distance — the index chooses who competes, the original vectors decide
# the order.
#
# index = "exact"
# iterative_scan = "relaxed_order"
# hnsw_m = 16
# hnsw_ef_construction = 64
# precision = "float32"
# rescore_oversampling = 4

# [packs.openai]
# Optional — every field here has a default, so this whole block can be absent and
# `weft-openai` still registers and still reports `active`. That is deliberate: a
# required credential would make the pack fail at start-up and its `openai` embedder
# would silently vanish from the registry on any machine without an account. With no
# key, the failure happens instead at the first thing that asks it to embed, and it
# names this line.
#
# The key is read from here and from nowhere else — never from the `OPENAI_API_KEY` the
# vendor SDK would pick up on its own, so a project that runs on one machine runs on
# every machine. `${env:...}` keeps the secret in the environment all the same.
#
# api_key = "${env:OPENAI_API_KEY}"
#
# Where to reach it. Unset means the vendor's own address, passed explicitly — the SDK
# reads `OPENAI_BASE_URL` for itself when handed nothing, and an endpoint this file did
# not name is an endpoint this file cannot be trusted about. The same holds for the two
# below and `OPENAI_ORG_ID` / `OPENAI_PROJECT_ID`. Any API speaking the same protocol
# goes here: a gateway, a proxy, a compatible local server.
#
# base_url = "https://api.openai.com/v1"
# organization = "org-..."
# project = "proj_..."
#
# `timeout_seconds` unset leaves the SDK's own default in force, which is *not* the same
# as passing it `None` — a value it honours as "no timeout at all".
#
# timeout_seconds = 30.0
#
# The SDK retries transient failures itself, at the transport, for this account's
# embeddings and image descriptions. Model calls ignore it: `[llm.retry]` is their one
# retry, so the two cannot multiply. Zero turns it off.
#
# max_retries = 2
#
# `structured_output` sends a typed answer's JSON Schema as `response_format`, so the endpoint
# constrains the answer's shape rather than reading the schema from the prompt. Off by default
# on both accounts: a server that rejects the field answers 400, and the answer then falls past
# the schema-in-the-prompt tier to a plain one. Turn it on once the endpoint is known to accept it.
#
# structured_output = false
#
# Which embedding model this account serves when no pipeline stage names one. Unset means
# the vendor's `text-embedding-3-small`. This is the only surface the *query* side can
# reach: `weft ask` embeds a question through `[services] embed`, never through a pipeline
# document, so without this an index built against one model was queried against another
# (`R22.1`). A stage's own `with: {model = "..."}` still wins.
#
# embedding_model = "text-embedding-3-small"

# [packs.openai-compatible]
# A *second* account for the same protocol — Phase 20a task `20.1`. A pack receives exactly
# one settings block, so `[packs.openai]` configures its embedder, its provider and its
# describer together and they cannot be pointed at different servers. This block is the
# second account: same fields, same meanings, independently set. Its plugins are
# `openai-compatible-embeddings`, `openai-compatible` and `openai-compatible-vision`.
#
# The use it exists for — embeddings from a server you run, answers from the vendor. Set
# `[services] embed` to "openai-compatible-embeddings" and leave `[llm.roles] generate`
# on `provider = "openai"`; `manual/operations-guide.md` shows the whole file.
#
# `stream_usage` asks the server to report token usage on a streamed answer
# (`stream_options.include_usage`). It is off by default for this account: OpenAI documents the field
# for its own API, and a local server that rejects an unknown request field would refuse every
# answer. With it off, this account's calls count as *not reported*, never as zero. Turn it on
# once your server accepts the field. Carried repair `R33.1`.
#
# stream_usage = false
# api_key = "${env:LOCAL_API_KEY}"
# base_url = "http://localhost:11434/v1"
# organization = "org-..."
# project = "proj_..."
# timeout_seconds = 30.0
# max_retries = 2
# structured_output = false
#
# **Set this one for a local server.** A model name is what an OpenAI-compatible server
# routes on, and a server you run serves the names it has — `nomic-embed-text` under
# Ollama, whatever you loaded under LM Studio or vLLM — not the vendor's catalogue. Both
# sides of a corpus read it: `weft index` embeds the chunks and `weft ask` embeds the
# question, and they have to be the same model or the store is comparing two unrelated
# spaces (`R22.1`).
#
# embedding_model = "nomic-embed-text"

# [packs.qdrant]
# Optional in the same way and for the same reason — every field has a default, so
# the pack registers whether or not a Qdrant is running and refuses at first use,
# naming the address it could not reach, rather than vanishing from the registry.
#
# This is the *second* store backend, and `01` → Runtime shape is explicit that it
# is proof rather than deployment: one container is the floor and it is pgvector.
# `docker compose --profile conformance up -d qdrant` starts it, deliberately behind
# a profile, and the store conformance suite is what asks for it.
#
# To actually run against it, name it in `[services] store` below. Settings here
# configure the pack; that key is what selects it.
#
# `vector_size` is the one setting Postgres has no equivalent of: a Qdrant collection
# fixes its vector width at creation and cannot be widened, so it has to name the
# width the configured embedder produces — 64 for `weft-embed`'s `hash`, 1536 for
# `openai`'s `text-embedding-3-small`. Changing embedder means changing this *and*
# re-indexing into a fresh `collection`.
#
# url = "http://localhost:6333"
# api_key = "${env:QDRANT_API_KEY}"
# collection = "weft_nodes"
# vector_size = 64
#
# `timeout_seconds` is how long the driver waits on one request, in whole seconds. Unset
# leaves the driver's own default in force, which is not the same as no timeout.
# `bm25_avg_doc_len` is the average document length the lexical arm's BM25 weights
# assume; a point's weight is computed once, when it is written, so this is a number
# an operator sees rather than one inherited silently.
#
# timeout_seconds = 30
# bm25_avg_doc_len = 256.0
#
# The vector arm, named from the same closed vocabulary `[packs.store]` uses — one set of
# words across both backends, so an index kind means the same thing wherever you write it.
#
# `index` is `hnsw` (the default) or `exact`. **The default differs from the pgvector
# store's on purpose**: Qdrant has always built an HNSW index once a segment passes its own
# indexing threshold, so `hnsw` records what this backend already does rather than changing
# it. `exact` is the opt-in that forces a full scan per search. `diskann` is a member of the
# vocabulary this backend does not serve — Qdrant uses HNSW as its only dense vector index —
# and asking for it is refused by name rather than quietly ignored.
#
# `precision` is `float32` (the default), `float16`, `int8` or `binary`. Qdrant serves all
# four by different mechanisms: `float16` is the vector datatype, `int8` is scalar
# quantization, `binary` is binary quantization, `float32` is the absence of both. Compression
# trades recall for size and speed, and float32 stays the default until a persisted `weft eval`
# run puts a compressed arm inside the baseline's own interval — Weft measured compression on
# pgvector, never here, so nothing has earned the move on this backend yet.
#
# **Changing `precision` against a collection that already has one is refused**, not applied:
# re-encoding stored vectors would silently change what every comparison means. A collection
# with *no* quantization is the undecided case and is configured in place. See
# `manual/troubleshooting.md` → `QuantizationMismatchError`.
#
# `payload_indexes` names which payload keys Qdrant indexes, and with what type. It defaults to
# `{"lineage.sources" = "keyword"}` and that entry is never dropped: `delete_source` and
# `reconcile` filter on that key on every call, so an index for it is not a tuning choice an
# operator should have to discover. Anything you add is merged with it, not substituted for it.
#
# **Timing is the whole point, not an optimisation.** Qdrant generates filterable-HNSW edges only
# for data indexed *after* a payload index exists. An index created later still answers filters,
# but the graph it needed was already built without it — so Weft creates every declared index
# before the first point is written. Phase 29 measured what that buys: with the payload index
# created before ingest, Qdrant returned recall@10 1.000 at 0.1% selectivity.
#
# The type is declared rather than inferred because Qdrant cannot infer it: an `ext.` path may
# hold a string, a number or a bool, and the index type decides which operators it can serve.
# `keyword` for identity matching, `integer` and `float` for ordered comparisons. A key no filter
# could ever address is refused here, by the same parser the filter translator uses — so you
# cannot index a path your queries could never name.
#
# `content` is deliberately not indexed: it is addressable and admits `eq`, but a keyword index
# over whole chunk text is paid for on every write and no filter Weft ships asks for it.
#
# index = "hnsw"
# precision = "float32"
# payload_indexes = { "lineage.sources" = "keyword", "ext.weft-pdf.page" = "integer" }
#
# `indexing_threshold` is how many points a segment must hold before Qdrant's optimizer builds
# an HNSW index for it. Unset leaves Qdrant's own default of 20,000 in force, which is what a
# real deployment wants: below that a full scan is both exact and faster than building a graph.
#
# **`0` does not mean "index immediately" — it disables indexing entirely**, which is Qdrant's
# own documented meaning and the opposite of what someone reaching for this setting intends. A
# small positive value is what forces an index on a collection too small to earn one; the store
# conformance kit sets `1` so a few hundred points leave the exact-search regime and the
# filtered-search checks run against a real approximate index.
#
# indexing_threshold = 20000
#
# `rescore_oversampling` is how many candidates a compressed search pulls from the quantized
# index per requested result, before re-ranking them against the full-precision vectors Qdrant
# stored beside them. It applies to `int8` and `binary` only: `float16` is the vector datatype
# rather than quantization, so a float16 collection holds nothing quantized to rescore.
#
# **It has no default here, and the absence is the decision.** Weft has never measured an
# oversampling curve on this backend — Phase 29's Qdrant arms measured payload indexes, not
# compression — so leaving it unset leaves in force the `1.0` the Qdrant client documents on the
# parameter itself, the same way `timeout_seconds` and `indexing_threshold` above leave the
# driver's and the server's own defaults alone.
#
# **The pgvector store's identically-named setting defaults to `4`, and that number does not
# transfer.** It comes from `29.8`, which measured recall@10 of 0.8075, 0.9565, 0.989 and 0.989
# at oversampling 1, 2, 4 and 10 — over a `bit` expression index rescored by an outer SQL query.
# Qdrant compresses and rescores by a different mechanism entirely, so borrowing the figure would
# tell you Weft had measured this backend when it has not. Set it from your own measurement, or
# leave it alone.
#
# rescore_oversampling = 4

# --- Services ----------------------------------------------------------------
# Which registered plugin fills a role a command needs. One line changes which
# embedder `weft index` and `weft ask` resolve, with no package edited and nothing
# reinstalled — including a plugin from a pack neither of us wrote.
#
# 'hash' carries no semantic meaning — it digests the text, so a ranking built from
# it says the pipeline ran and nothing about relevance. Set [services] embed in
# weft.toml to change it: 'openai-embeddings' for the vendor, or
# 'openai-compatible-embeddings' pointed at an OpenAI-compatible server you run,
# which needs no account.
#
# No credential, no network and no model download is what that default buys, and it is
# why a clean checkout runs end to end with nothing configured at all.
#
# Changing this means reindexing into an empty store: a stored vector is only comparable
# to a question embedded by the same model. See manual/operations-guide.md ->
# Choosing an embedder.
#
# `store` selects the backend the same way, from the same registry, and it applies to
# `weft index` and `weft ask` together on purpose: a corpus written to one store and a
# question asked of another returns nothing and reports no error. The default is
# `pgvector`. Changing it means re-indexing — the corpus does not move with the key.
#
# `graph` is a **role a pack declared**, not a key `weft-cli` knows about — ledger task 9.0
# generalised `[services]` so any installed pack can publish one, and `weft_kg` publishes
# this one against its own `GraphTraversal` contract. It is what a graph retriever reaches
# through `ctx.require`, and a rung that names one (`graph-then-generate` and the three
# beside it) is refused **by name at assembly**, before any stage runs, when nothing is
# selected for it. `weft plugins doctor` lists every role every installed pack declares,
# which is the only honest list — this file cannot enumerate keys packs invent.
#
# [services]
# embed = "openai-embeddings"
# store = "qdrant"
# graph = "pgvector-traversal"

# --- Permissions ---------------------------------------------------------------
# An operator's override of the two classes docs/03-cli.md -> Permissions defaults
# to "ask": `overwrite` (reindexing an existing collection, replacing a pipeline
# file) and `destroy` (dropping a collection, deleting blobs, purging a cache).
# `read`/`write` are unconditionally `allow` and are not keys here; `network`'s own
# "allow, configurable" is a separate knob no command reads yet.
#
# "ask" is every field's own built-in default, so leaving this whole block absent
# is identical to writing it out with both keys set to "ask" — an overwrite/destroy-
# class command still refuses to run with no TTY, naming --yes, and never proceeds
# silently. "allow" is the only override, e.g. for a CI job that already trusts its
# own pipeline and would rather not pass --yes on every invocation.
#
# [permissions]
# overwrite = "ask"
# destroy = "allow"

# --- Reconcile ------------------------------------------------------------------
# `weft reconcile`'s own personal default for a bare `--mode` — task 5.1c. "full" is
# every field's own built-in default, unchanged from before this block existed:
# someone typing `weft reconcile` with no flag means the expensive, full-convergence
# pass. An operator who runs it often and would rather it default to the cheaper
# `repair` sets it here; `weft reconcile --mode full` still reaches `full` for one
# invocation regardless of what this says — the flag always wins.
#
# This has no effect on `weft index`'s own automatic post-index pass, which is
# hardcoded to `repair` and reads nothing from this block on purpose: see
# docs/02-extension-model.md -> §3 Slots for why an automatic pass may never reach
# `full` on its own. `weft index --reconcile full` is how a person opts one index
# run into it.
#
# [reconcile]
# mode = "repair"

# --- Which model answers a role ----------------------------------------------
# A pipeline stage never names a provider or a model — it names a *role*
# (`generate`, `grade`, `rerank`, `route`, or any name a technique plugin's own
# `role:` configuration reads). This table is what turns a role into an account
# and a model, so a grader and a generator can share one provider registration
# and still answer under two different models.
#
# Every role left unmapped fails loudly the first time something asks it to
# answer, naming the role and every role that *is* mapped — there is no
# silent default here, the same posture `[services]` sets above.
#
# `rerank` is the role the shipped `llm-rerank` plugin asks under by default.
#
# [llm.roles]
# generate = { provider = "openai", model = "gpt-5.6-luna" }
# grade    = { provider = "openai", model = "gpt-5.6-luna" }
# rerank   = { provider = "openai", model = "gpt-5.6-luna" }
# route    = { provider = "scripted" }

# --- How hard to try when a model call fails transiently ---------------------
# Retry is attached once, around the provider, and no technique re-implements
# it. It re-attempts exactly the failures the taxonomy marks transient — a rate
# limit, a timeout, a dropped connection, a vendor 5xx — and never a permanent
# one, because a bad request or a wrong credential fails identically on the
# second attempt and retrying it only turns an error into a wait.
#
# `attempts` counts the first call, so `1` means "do not retry". The delay
# doubles from `base_delay_ms` and stops at `max_delay_ms`. There is no jitter:
# one `weft ask` is not a fleet, and a deterministic backoff is one a test can
# assert on. A stream that has already produced a token is never restarted —
# re-running it would replay text a reader has seen.
#
# [llm.retry]
# attempts = 3
# base_delay_ms = 250
# max_delay_ms = 8000

# --- The trust model ---------------------------------------------------------
# `allow` is an exhaustive opt-in pin of distribution names. Absent means open,
# which is the default posture: the threat this addresses is installed-and-
# ambient rather than malicious — an entry point turns *installed* into
# *executed with your privileges*.
#
# Uncomment to pin. Anything not listed is refused and, importantly, never
# imported. `weft plugins doctor` can flag a running pack `ambient` — meaning it is
# not a direct dependency of the project, arrived transitively rather than by a
# deliberate `uv add` — but that is unrelated to this pin: it depends on the CLI
# telling `weft` which distributions are direct dependencies, which Phase 0's CLI
# does not yet do, so no pack carries the flag yet. Read the `status` column, not
# `ambient`, until that lands.
#
# **A pin has to list the pack behind every plugin name this file selects**, including the
# one `[services] embed` names — the list below permits `weft-openai` for exactly that
# reason. Leave a selected pack off and `weft index` stops before it runs, exits 3, and
# names this key; that is the repair for a reviewer finding against the example you are
# reading, which used to select `openai` above and refuse `weft-openai` here.
#
# [packs]
# allow = ["weft-extract", "weft-chunk", "weft-embed", "weft-store", "weft-openai"]

# --- Plugin collisions --------------------------------------------------------
# Two packs registering the same name under the same contract is refused at
# registration by default — `weft plugins doctor` will name both distributions
# and print the exact block below. `[plugins]` is how you resolve it instead of
# renaming one: keyed "Contract:name", valued the distribution that should win.
# The other pack stays installed and active; it is simply reported as having
# lost that one name (`weft plugins doctor`'s `displaced:` line).
#
# A pin naming a distribution that never actually claimed the name, or one for
# a pair that never collided at all, is refused just as loudly as an unpinned
# collision — an unused pin is not a harmless no-op, it is a claim about what
# is running that turned out to be false.
#
# [plugins]
# "Enhancer:keybert" = "weft-kw"


# --- Packs with settings of their own -----------------------------------------
# Everything below is optional; each block can be absent and its pack still
# registers. Added 2026-09-10 by carried repair `R9.6`: these fields existed and
# this file named none of them, so the only way to find one was to read the pack's
# source. `tests/docs/test_pack_settings_documented.py` now refuses that state.

# [packs.cross-encoder]
# Where the Text Embeddings Inference server that `cross-encoder-rerank` scores through
# runs (`pip install weft-rag[cross-encoder]`). Every field has a default, so the pack
# registers with no server running and refuses at first use, naming the address. The
# model is not set here: each stage names it in `with: {model: …}`, and the reranker
# checks it against the server's `/info` before scoring anything.
#
# url = "http://localhost:8080"
#
# `timeout_seconds` is how long one request may take, in seconds; a reranker scoring fifty
# passages on a CPU takes about a second per request on the machine this was measured on.
#
# timeout_seconds = 30.0

# [packs.graph]
# `weft-kg`'s own connection, and it is **not** inherited from `[packs.store]` or from
# an exported `WEFT_DATABASE_URL`: this pack is offered no ambient setting, so the line
# below is what points it at the container the store already uses. Empty is the default
# and is deliberate — `register()` must succeed on a machine with no `weft.toml`, so a
# project that never names this pack sees an ordinary `active` row rather than a `failed`
# one it has to read past. The connection is opened lazily, so the refusal arrives at the
# first call that genuinely needs one.
#
# dsn = "${env:WEFT_DATABASE_URL}"
#
# The three below configure the entity-resolution pass `weft reconcile` runs — pack
# settings rather than stage `with:` config because that pass is not a pipeline stage,
# so there is no per-stage config object for it to read.
#
# `adjudication_floor` is the band's lower edge: below this score a candidate pair is
# never put to a model at all. `adjudication_role` is the `[llm.roles]` key the pass
# resolves a provider through — index-side work, so it defaults to `index`.
# `max_concurrent_adjudications` is what a configured provider tolerates, which is an
# operator's fact rather than this pack's.
#
# adjudication_floor = 0.6
# adjudication_role = "index"
# max_concurrent_adjudications = 8
#
# The project-local curated schema a `weft graph activate` run wrote. Empty — the
# default — means no schema is active: extraction constrains and stamps nothing. One
# path per project, so every stage reads the schema the corpus is actually under rather
# than a value some pipeline document happened to repeat.
#
# schema_file = "graph-schema.json"

# [packs.blob]
# The one required field of any pack that has one, following `[packs.store] dsn`'s
# precedent: a pack cannot invent where an operator's bytes live, so `root` has no
# default. Every blob a multimodal extractor produces is written under it, and the
# directory and its layout marker are created on first use.
#
# root = "./blobs"

# [packs.docling]
# Where the layout model's weights live on disk. A *pack* setting rather than a stage
# one because `register()` is what reads it, to decide whether the rung it is about to
# register can actually run — and registration sees only pack settings. Unset means the
# library's own default location.
#
# artifacts_path = "/path/to/docling/models"

# [packs.agent]
# The agent loop's step budget — an operator's decision rather than a number baked into
# the pack. Ten is enough for a handful of tool calls plus a final answer on the kind of
# multi-step question this pack exists for, without letting a model stuck in a loop run
# away unbounded.
#
# max_steps = 10

# [packs.otel]
# Where spans go. `exporter = "none"` (the default) records nothing beyond the process;
# "console" prints them; "otlp" sends them to `endpoint`, and without an endpoint or the
# `weft-rag[otel]` extra it falls back to "console", loudly, rather than failing a run.
# `service_name` is the
# `service.name` every span carries, worth setting even for the console exporter so two
# projects' spans stay distinguishable. `api_key` is sent as the literal `Authorization`
# header value, so name the whole bearer value.
#
# exporter = "none"
# service_name = "weft"
# endpoint = "http://localhost:4318"
# api_key = "${env:OTEL_API_KEY}"
